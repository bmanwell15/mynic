import "./Protocols/IP.myn";

enum uint8 ICPM_TYPE {
    ECHO_REPLY = 0,
    DESTINATION_UNREACHABLE = 3,
    SOURCE_QUENCH,
    REDIRECT_MESSAGE,
    ALTERNATE_HOST_ADRESS,
    ECHO_REQUEST = 8,
    ROUTER_ADVERTISEMENT,
    ROUTER_SOLICITATION,
    TIME_EXCEEDED,
    PARAMETER_PROBLEM,
    TIMESTAMP,
    TIMESTAMP_REPLY,
    INFORMATION_REQUEST,
    INFORMATION_REPLY,
    ADDRESS_MAST_REQUEST,
    ADDRESS_MAST_REPLY,
    TRACEROUTE = 30,
    DATAGRAM_CONVERSION_ERROR,
    MOBILE_HOST_REDIRECT,
    WHERE_ARE_YOU,
    HERE_I_AM,
    MOBILE_REGISTRATION_REQUEST,
    MOBILE_REGISTRATION_REPLY,
    DOMAIN_NAME_REQUEST,
    DOMAIN_NAME_REPLY,
    SKIP_ALGORITHM_DISCOVERY_PROTOCOL,
    SECURITY_FAILURE,
    EXPERIMENTAL_MOBILITY_PROTOCOLS,
    EXTENDED_ECHO_REQUEST,
    EXTENDED_ECHO_REPLY,
    RFC3692_EXPERIMENT_1 = 253,
    RFC3692_EXPERIMENT_2 = 253
}

enum uint8 ICPM_CODE_DESTINATION_UNREACHABLE {
    NETWORK_UNREACHABLE,
    HOST_UNREACHABLE,
    PROTOCOL_UNREACHABLE,
    FRAGMENTATION_REQUIRED,
    FAILED_SOURCE_ROUTE,
    DESTINATION_NETWORK_UNKNOWN,
    DESTINATION_HOST_UNKNOWN,
    SOURCE_HOST_ISOLATED,
    NETOWRK_PROHIBITED,
    HOST_PROHIBITED,
    COMMUNICATION_PROHIBITED,
    HOST_PRECEDENCE_VIOLATION,
    PRECEDENCE_CUTOFF_EFFECTIVE
}

enum uint8 ICPM_CODE_REDIRECT_MESSAGE {
    REDIRECT_FOR_NETWORK,
    REDIRECT_FOR_HOST,
    REDIRECT_FOR_ToS_NETWORK,
    REDIRECT_FOR_ToS_HOST
}

enum uint8 ICPM_CODE_EXTENDED_ECHO_REPLY {
    SUCCESS,
    MALFORMED_QUERY,
    NO_SUCH_INTERFACE,
    NO_SUCH_TABLE_ENTRY,
    MULTIPLE_INTERFACES_SATISFY_QUERY
}

segment ICMP_IP_HEADER {
    bytes4 reserved {hidden: true};
    IP_HEADER ipHeader;
    bytes8 originalDatagramData;
}

segment ICMP_REDIRECT_HEADER {
    ipv4Address ipAddress;
    IP_HEADER ipHeader;
    bytes8 originalDatagramData;
}

segment ICMP_TIMESTAMP_HEADER {
    uint16 identifier;
    uint16 sequenceNumber;
    datetime32s originalTimestamp {expr: originalTimestamp * 1000}; // convert to milliseconds
    datetime32s recievedTimestamp {expr: recievedTimestamp * 1000};
    datetime32s transmitTimestamp {expr: transmitTimestamp * 1000};
}

segment ICMP_ADDRESS_MASK_HEADER {
    uint16 identifier;
    uint16 sequenceNumber;
    bytes4 addressMask
}

segment DESTINATION_UNREACHABLE_HEADER {
    byte reserved {hidden: true};
    uint8 length;
    bytes2 nextHopMTU
    IP_HEADER ipHeader;
    bytes payload[TO_END];
}

segment ICMP_EXTENSION_OBJECT {
    uint16 length; // in bytes
    byte classNum;
    byte CType;
    bytes4 payload[length / 4]; // forces 4 byte chunks
}

packet ICMP_EXTENSION_PACKET {
    bitfield version {
        uint version : 4;
        bits reserved : 12 {hidden: true};
    }
    bytes2 checksum;
    ICMP_EXTENSION_OBJECT extensionObjects[TO_END];
}

segment ICMP_HEADER {
    ICPM_TYPE type;
    
    switch type {
        segment code {
            ICPM_CODE_DESTINATION_UNREACHABLE code;
        } if 3;
        segment code {
            ICPM_CODE_REDIRECT_MESSAGE code;
        } if 5;
        segment code {
            ICPM_CODE_EXTENDED_ECHO_REPLY code;
        } if 43;
        segment code {
            uint8 code;
        } defaults;
    }

    bytes2 checksum;
    switch type {
        ICMP_IP_HEADER if 4;
        ICMP_REDIRECT_HEADER if 5;
        ICMP_IP_HEADER if 11;
        ICMP_TIMESTAMP_HEADER if 13;
        ICMP_TIMESTAMP_HEADER if 14;
        ICMP_ADDRESS_MASK_HEADER if 17;
        ICMP_ADDRESS_MASK_HEADER if 18;
        segment defaultSegment {
            bytes reserved[TO_END] {hidden: true};
        } defaults;
    }
}

packet ICMP_PACKET {
    ICMP_HEADER header;
    bytes payload[TO_END];
}