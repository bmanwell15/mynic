/*  POSSIBLE PRIMITIVE DATATYPES

    bit                 1 bit - Can only be used in a bitfield

    bool                1 byte
    char                1 byte

    int                 4 bytes
    uint                4 bytes
    intX                X bits
    uintX               X bits
    short               2 bytes
    ushort              2 bytes
    long                8 bytes
    ulong               8 bytes

    float               4 bytes
    float32             4 bytes
    double              8 bytes
    float64             8 bytes
*/

include "./examples/imported.myn"

typedef uint8 oneByte

define TEST_DEF 12

enum uint8 ENUM_TEST { // Must be some form of integer
    ONE = 1,
    TWO,
    THREE
}

default {
    units: "lbs"
}

packet GPS {
    default {
        endianness: "little"
    }

    float lat // This is a comment
    float lon
    uint alt /*
        This
        is
        a multi
        lined
        comment
    */bool valid

    uint8 specialInt
    int32 bigInt
    uint17 weirdInt
    oneByte endingBte
    ENUM_TEST enumVal;

    uint8 customData { endianness: "big", units: "m/s" }

    bitfield bitFieldExample {
        bit flag1       : 1 { endianness: "big" };
        uint reTries    : 3 { units: "BITS" };
        bit remainder   : 4;
    }

    union unionField {
        uint8 parseMethodOne { units: "m/s" };
        uint8 parseMethodTwo { units: "ft/hr" };
    }
}


segment ExampleSegment { // As of now, segments can only be defined outside of packet
    default {
        endianness: "little"
    }
    
    uint8 field1;
    float32 field2;
}

packet TestSegments {
    uint8 header;
    ExampleSegment seg1;

    float byteArr[13]; // Array of 13 floats -> 13 * 4 bytes

    uint8 count;
    byte dynamicArray[count]; // make an array of bytes "count" long
    byte dynamicArrOtherPacket[customData]; // Can cross to other packets

    uint8 branch {
        ExampleSegment if 0;
        GPS if TEST_DEF;
    }
}